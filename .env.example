# ============================================================================
# AttendX environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# ---- App mode -------------------------------------------------------------
# "demo"  -> local mock repository backed by localStorage (no cloud needed)
# "cloud" -> authenticated Supabase + Vercel serverless functions
VITE_APP_MODE=demo

# ---- Frontend (safe to expose; shipped to the browser) --------------------
# Anon/publishable key is designed to be public and is protected by RLS.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here

# ---- Server only (Vercel Serverless Functions) ----------------------------
# NEVER prefix these with VITE_. They must stay on the server.
# The service role / secret key bypasses RLS — treat it like a root password.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_or_secret_key_here

# Attendance policy threshold (percent). Students below this are "at risk".
ATTENDANCE_THRESHOLD=75
